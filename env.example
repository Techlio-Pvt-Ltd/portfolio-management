# Copy this file to .env.local and fill in values from your Firebase project
# (Firebase Console > Project Settings > General > Your apps > SDK setup and configuration).

# Optional — defaults to 3000 if unset
# PORT=3001

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Your dashboard admin's UID (Firebase Console → Authentication → Users →
# User UID column). API routes and Firestore rules only trust this account —
# self-registered users are rejected. Also hardcoded in firestore.rules.
ADMIN_UID=

# Cloudinary for signed image uploads (Cloudinary Dashboard →
# Product Environment Credentials box on the home page)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=