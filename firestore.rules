rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access to portfolio content, writes only allowed for the
    // signed-in admin (any authenticated user, since this project has a
    // single admin account created manually in Firebase Auth).
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
