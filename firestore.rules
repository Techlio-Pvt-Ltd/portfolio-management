rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access to portfolio content, writes only allowed for the
    // admin account below. Anyone can self-register a Firebase user with the
    // public API key, so request.auth != null alone would let strangers write.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "2Rn3fjJx8nQjBDp2bUxIuNshFtE3";
    }
  }
}
